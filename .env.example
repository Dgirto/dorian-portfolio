# Copia este archivo como .env y completa los valores de tu panel de EmailJS (emailjs.com).
# Vite solo expone al navegador las variables que empiezan por VITE_. Reinicia `npm run dev` tras editarlo.
# La plantilla de EmailJS debe usar las variables {{nombre}}, {{email}} y {{mensaje}}.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
